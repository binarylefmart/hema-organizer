# ============================================================================
#  HEMA Organizer — variables d'environnement
# ============================================================================
#  Développement local : copier ce fichier en `.env` (jamais commité) et remplir.
#  Production (Portainer) : ces mêmes variables se saisissent dans l'écran
#  « Environment variables » de la stack — voir docs/DEPLOIEMENT.md.
#
#  Les variables marquées « développement uniquement » ne doivent JAMAIS être
#  définies en production.
# ============================================================================


# ---------------------------------------------------------------------------
#  Application
# ---------------------------------------------------------------------------

# Domaine public de l'app, SANS https:// — sert à construire les liens des emails.
# Production : organizer.mon-club.fr · Développement : localhost:3000
DOMAIN=localhost:3000

# Secret de signature (cookies de session, jeton 2FA, liens signés de désinscription
# et d'annulation, chiffrement des secrets TOTP). 32 caractères minimum, obligatoire.
# Générer : openssl rand -base64 48
# Le changer déconnecte tout le monde et rend illisibles les secrets TOTP enregistrés.
SESSION_SECRET=

# Base SQLite. Le chemin relatif est résolu depuis le dossier prisma/.
# Développement : file:../data/organizer.db · Production (volume Docker) : file:/data/organizer.db
DATABASE_URL=file:../data/organizer.db

# Vérification des mises à jour : l'encart « Mise à jour disponible » du profil
# (administrateurs) compare la version qui tourne aux tags de cette image publique
# sur Docker Hub — requête anonyme, au plus une toutes les 6 h. Laisser vide coupe
# la vérification (aucune requête ne sort).
MISE_A_JOUR_DEPOT=hematools/hema-organizer
# Lien « Ce que change la version » de l'encart : la release GitHub du tag ({version}
# est remplacé). Adresse https:// seulement.
MISE_A_JOUR_NOTES=https://github.com/binarylefmart/hema-organizer/releases/tag/v{version}

# Dossier des sauvegardes quotidiennes de la base (rétention 30 jours).
# Développement : ./backups · Production (volume Docker) : /backups
BACKUP_DIR=./backups

# Dossier des affiches d'événements. FACULTATIVE : par défaut, le dossier de la
# base suivi de « /affiches » (donc /data/affiches en production, dans le volume
# existant). Rien à ajouter dans la stack Portainer.
# UPLOAD_DIR=./data/affiches

# Fuseau horaire des tâches planifiées (sauvegarde 03:30, entretien 07:00).
TZ=Europe/Paris


# ---------------------------------------------------------------------------
#  Identité du club — FACULTATIVE
# ---------------------------------------------------------------------------
#  Le nom, le sigle, le thème, la couleur et le logo se règlent DANS
#  l'application : espace admin → « Identité ». Ces deux variables ne servent
#  qu'à nommer une instance neuve AVANT que quiconque ait ouvert cet écran —
#  pratique pour qu'un déploiement affiche tout de suite le bon nom sur l'écran
#  de connexion. Un réglage fait dans l'application les emporte définitivement.
#  Laissées vides, l'application s'appelle « HEMA Organizer ».

# CLUB_NOM=Mon club d'escrime historique
# CLUB_SIGLE=MCEH


# ---------------------------------------------------------------------------
#  Compte d'administration (créé au démarrage, de façon idempotente)
# ---------------------------------------------------------------------------
#  C'est la SEULE adresse qui se connecte par mot de passe : tout le monde
#  entre par son lien personnel. Le mot de passe ci-dessous est PROVISOIRE —
#  l'application impose d'en choisir un autre et de configurer la double
#  authentification à la première connexion.
#  Un compte déjà existant n'est jamais modifié : changer ADMIN_PASSWORD ici
#  après coup n'a aucun effet (utiliser « Mot de passe oublié »).

ADMIN_EMAIL=contact@mon-club.fr
# 10 caractères minimum, sinon le compte n'est pas créé.
ADMIN_PASSWORD=
# Identité affichée du compte (facultatif, défaut : « Bureau » + le sigle du club).
ADMIN_PRENOM=Bureau
ADMIN_NOM=


# ---------------------------------------------------------------------------
#  Emails (Nodemailer SMTP)
# ---------------------------------------------------------------------------
#  Liens d'accès, rappels, alertes, réinitialisation de mot de passe.
#  SMTP_HOST vide = aucun envoi : les emails sont écrits dans previews/emails/.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sans guillemets, et c'est volontaire : recopiée telle quelle dans une variable de stack Portainer,
# une valeur entre guillemets les garde (un fichier .env, lui, les retire). Le serveur SMTP répond
# alors « 501 5.1.7 Bad sender address syntax » et plus aucun email ne part.
SMTP_FROM=Mon club <contact@mon-club.fr>


# ---------------------------------------------------------------------------
#  Discord
# ---------------------------------------------------------------------------
# Webhook du salon où publier le récapitulatif de la veille.
# Peut être surchargé depuis Administration → Paramètres (la valeur en base gagne).
DISCORD_WEBHOOK_URL=


# ---------------------------------------------------------------------------
#  Telegram — FACULTATIF
# ---------------------------------------------------------------------------
#  Même rôle que Discord : les messages collectifs (récap de la veille,
#  annulation, « peu de monde », nouvel événement) dans un groupe ou un canal.
#  Deux valeurs suffisent, et elles se règlent aussi dans l'application
#  (espace admin → Notifications → Telegram), où elles sont rangées CHIFFRÉES
#  en base — la valeur en base gagne sur celle d'ici.
#
#  Comment les obtenir : écrire à @BotFather sur Telegram, « /newbot », garder le
#  jeton ; ajouter le bot au groupe, puis y envoyer un message et lire
#  https://api.telegram.org/bot<JETON>/getUpdates pour relever « chat.id »
#  (un identifiant de groupe commence par un tiret).
#  L'écran Telegram de l'application fait ce relevé pour vous.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ---------------------------------------------------------------------------
#  Notifications sur le téléphone (Web Push) — RIEN À DÉFINIR
# ---------------------------------------------------------------------------
#  Ne cherchez pas de variable VAPID : il n'y en a pas, et il ne faut pas en
#  ajouter. Les clés d'envoi sont engendrées automatiquement au premier besoin
#  et rangées chiffrées en base (table Setting, comme le webhook Discord) : elles
#  survivent ainsi aux mises à jour de l'image, puisqu'elles vivent dans le
#  volume de données. Les changer invaliderait tous les abonnements existants.
#
#  Seule contrainte : le site doit être servi en HTTPS (ou en localhost pour le
#  développement) — sans quoi le navigateur refuse l'abonnement.
#  Chacun active ensuite les notifications appareil par appareil, depuis
#  « Mon profil ». Voir docs/DEPLOIEMENT.md.


# ---------------------------------------------------------------------------
#  API publique (site WordPress)
# ---------------------------------------------------------------------------
# Seule origine autorisée par CORS sur /api/public/*, c'est-à-dire le site du club.
# VIDE PAR DÉFAUT : aucun site n'est autorisé à lire l'API depuis un navigateur. Le plugin
# WordPress, lui, appelle depuis son serveur et n'a pas besoin de cette variable.
PUBLIC_API_ORIGIN=


# ============================================================================
#  DÉVELOPPEMENT UNIQUEMENT — ne pas définir en production
# ============================================================================

# "1" : les emails sont écrits dans previews/emails/ au lieu d'être envoyés,
# même si un SMTP est configuré (tests, captures d'aperçu).
EMAIL_MODE_FICHIER=1

# "1" : désactive le limiteur de débit (connexion, liens, API publique).
# Sans effet si NODE_ENV=production.
RATE_LIMIT_DISABLED=1

# "1" : n'enregistre aucune tâche planifiée (sauvegarde, entretien quotidien).
CRON_DISABLED=0

# Relève le plafond de 3 appareils par lien personnel (tests e2e, captures).
# Sans effet si NODE_ENV=production. Laisser vide en usage normal.
LIEN_MAX_APPAREILS=

# URL visée par npm run preview:screenshots (défaut : http://localhost:3000).
# PREVIEW_BASE_URL=http://localhost:3000
